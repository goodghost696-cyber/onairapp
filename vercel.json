{
  "functions": {
    "api/claude.js": { "memory": 512, "maxDuration": 30 },
    "api/exercises.js": { "memory": 256, "maxDuration": 10 },
    "api/quote.js": { "memory": 128, "maxDuration": 10 },
    "api/food-search.js": { "memory": 128, "maxDuration": 10 },
    "api/recipe-from-link.js": { "memory": 128, "maxDuration": 15 },
    "api/send-push.js": { "memory": 128, "maxDuration": 10 },
    "api/cron/inactivity-nudge.js": { "memory": 256, "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron/inactivity-nudge", "schedule": "0 10 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
