# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_GYM_NAME=
VITE_GYM_CITY=
VITE_GYM_ADDRESS=

# Server-only — signup invite code (validated in api/validate-invite.js,
# never sent to the client). Falls back to 'ONAIR2026' if unset.
INVITE_CODE=

# Web Push (member-side notifications, api/send-push.js). Generate a pair
# with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VITE_VAPID_PUBLIC_KEY must be the same value as VAPID_PUBLIC_KEY — one is
# read client-side (subscribing the browser), the other server-side
# (signing the push). VAPID_PRIVATE_KEY must never be exposed to the client.
VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@onairapp.com
