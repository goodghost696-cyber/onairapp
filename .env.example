# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_GYM_NAME=
VITE_GYM_CITY=
VITE_GYM_ADDRESS=

# Server-only — signup invite code (validated in api/validate-invite.js,
# never sent to the client). Falls back to 'ONAIR2026' if unset.
INVITE_CODE=

# Web Push (member-side notifications, api/send-push.js). Generate a pair
# with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VITE_VAPID_PUBLIC_KEY must be the same value as VAPID_PUBLIC_KEY — one is
# read client-side (subscribing the browser), the other server-side
# (signing the push). VAPID_PRIVATE_KEY must never be exposed to the client.
VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@onairapp.com

# Server-only — authenticates Vercel's daily cron request to
# api/cron/inactivity-nudge.js (Vercel sends this as "Authorization: Bearer
# <value>" automatically once set). Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Server-only — already present in this project's Vercel settings
# (Production). Needed by api/cron/inactivity-nudge.js to read across every
# member's activity/subscriptions with no per-request user token to scope
# RLS to (a system job, not a logged-in coach/member action). Never expose
# this to the client.
SUPABASE_SERVICE_ROLE_KEY=
